TOWN_NAME=St Andrews
DATABASE_URL=postgres://user:password@host:5432/resicard
JWT_SECRET=change-me
PUBLIC_BASE_URL=http://localhost:5000
RESIDENT_ANNUAL_FEE_GBP=25
MERCHANT_STANDARD_MONTHLY_FEE_GBP=30
MERCHANT_INSIGHT_MONTHLY_FEE_GBP=75
# Retired name for the Standard fee; still read as its default.
# MERCHANT_PREMIUM_MONTHLY_FEE_GBP=30
FREE_PLAN_LIVE_OFFER_LIMIT=2
FREE_TRIAL_DAYS=90
LOCAL_POSTCODE_PREFIXES=KY16,KY15,KY10,DD6
# Residents and outlets must both reach this before the public counter is shown.
PUBLIC_COUNTER_MIN=40
POSTCARD_CODE_DAYS=60
POSTCARD_MAX_ATTEMPTS=5
# ADMIN_SETUP_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Where the resident map opens, and where a merchant's pin starts before it is placed.
MAP_CENTRE_LAT=56.339
MAP_CENTRE_LNG=-2.795
# Map tiles. The default below is OpenStreetMap's public tile server, which is fine
# for development but whose usage policy is not meant for a commercial product. Set a
# keyed provider (MapTiler and Mapbox both have free tiers around 100k loads a month)
# before launch. With no tile URL the map view falls back to the offers list.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
