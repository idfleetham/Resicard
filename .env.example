TOWN_NAME=St Andrews
DATABASE_URL=postgres://user:password@host:5432/resicard
JWT_SECRET=change-me
PUBLIC_BASE_URL=http://localhost:5000
RESIDENT_ANNUAL_FEE_GBP=36   # billed annually; the app quotes it as £3 a month
MERCHANT_STANDARD_MONTHLY_FEE_GBP=30
MERCHANT_INSIGHT_MONTHLY_FEE_GBP=75
# Retired name for the Standard fee; still read as its default.
# MERCHANT_PREMIUM_MONTHLY_FEE_GBP=30
FREE_PLAN_LIVE_OFFER_LIMIT=2
FREE_TRIAL_DAYS=90
# A bare district (KY16) matches the whole district; a district plus one digit
# (KY15 4) matches only that sector.
LOCAL_POSTCODE_PREFIXES=KY16,KY9,KY10,KY15 4,KY15 5
# Residents and outlets must both reach this before the public counter is shown.
PUBLIC_COUNTER_MIN=40
POSTCARD_CODE_DAYS=60
POSTCARD_MAX_ATTEMPTS=5
# Where and when a resident can be verified in person, shown next to the postcard
# route. Leave it unset until there is a regular time and place: the default says
# to get in touch and arrange one.
# VERIFY_IN_PERSON_DETAILS=Any Tuesday, 10am to noon, at the library on Church Square.
# Web push (campaigns). Generate a pair once with `npx web-push generate-vapid-keys`
# and keep them for the life of the deployment: new keys invalidate every browser
# subscription residents have already granted. With no keys set, push is off.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@resicard.co.uk

# Email. With no RESEND_API_KEY nothing is sent: every message is printed to the
# server log instead, which is the default and works with no account anywhere.
# Resend's EU region keeps the data in Europe, so there is no transfer to explain.
# RESEND_API_KEY=
EMAIL_FROM=Resicard <hello@resicard.co.uk>
EMAIL_REPLY_TO=hello@resicard.co.uk
# The sender's postal identity, printed in the footer of every message.
EMAIL_POSTAL_ADDRESS=Resicard, St Andrews, Fife, Scotland
# Bearer token for POST /api/jobs/daily. Unset means the route is closed and the
# reminders only run from `npm run jobs:daily`.
# JOBS_SECRET=

# ADMIN_SETUP_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Product tax codes for checkout line items. Optional; the defaults below are used
# if unset. Stripe accounts with Managed Payments enabled reject a checkout whose
# line item has no tax code.
# STRIPE_TAX_CODE_MEMBERSHIP=txcd_20030000
# STRIPE_TAX_CODE_MERCHANT_PLAN=txcd_10103001

# Where the resident map opens, and where a merchant's pin starts before it is placed.
MAP_CENTRE_LAT=56.339
MAP_CENTRE_LNG=-2.795
# Map tiles. Ordnance Survey's OS Maps API is the intended provider: UK-only detail,
# a generous free allowance and no international data transfer. Take a key from the OS
# Data Hub and restrict it by referrer there, because it ships in the client bundle and
# is therefore public. Light_3857 is the style closest to the Resicard palette, and OS
# require their attribution to stay visible on the map. With no tile URL set the map
# view falls back to the offers list, which is the deliberate default: nothing ships
# pointing at someone else's public tile server.
# OS raster styles have style-specific zoom limits, so the ceiling is configurable.

# Map tiles. Ordnance Survey OS Maps API, ZXY endpoint, on a 3857 layer (Leaflet
# draws in Web Mercator, so a 27700 layer will not line up). Copy the endpoint
# straight from the OS Data Hub project page, key and all. Read at runtime, so a
# restart is enough; no rebuild needed. Leave unset and the map falls back to a list.
# MAP_TILE_URL=https://api.os.uk/maps/raster/v1/zxy/Light_3857/{z}/{x}/{y}.png?key=YOUR_KEY
# MAP_TILE_ATTRIBUTION=Contains OS data © Crown copyright and database right 2026
# MAP_MAX_ZOOM=18

# Set while the site carries demo data. Puts an honest notice on the public pages
# saying the outlets shown are examples and no business listed has signed up.
# Remove it before the first real member joins.
# PREVIEW_MODE=true
